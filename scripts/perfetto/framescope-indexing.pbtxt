# FrameScope Android indexing trace configuration.
#
# Normal adb shell + Perfetto only. No root, su, privileged sysfs/procfs writes, governor changes,
# cpuset changes, or thermal-control changes are required or permitted by this workflow.

buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}

duration_ms: 90000

# Scheduler state, wakeups, thread lifetime, CPU placement, and CPU DVFS/idle state.
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      atrace_apps: "com.framescope.app"
      atrace_categories: "am"
      atrace_categories: "binder_driver"
      atrace_categories: "dalvik"
      atrace_categories: "gfx"
      atrace_categories: "view"
    }
  }
}

# Resolve process/thread ownership and names at capture start.
data_sources {
  config {
    name: "linux.process_stats"
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

# Poll CPU frequencies as a fallback for devices that emit sparse cpufreq tracepoints.
data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      cpufreq_period_ms: 250
    }
  }
}
